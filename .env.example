# Copy to .env (git-ignored) and fill in. Used by the company console (npm run console).

# Admin console sign-in
PLANNIE_ADMIN_PASSWORD=

# Plannie's mailbox via AgentMail (agentmail.to → dashboard → API Keys). Plannie creates plannie@agentmail.to itself.
AGENTMAIL_API_KEY=
# Inbox name (default plannie → plannie@agentmail.to)
# AGENTMAIL_INBOX=plannie

# Plannie's mailbox: a dedicated Gmail account + an app password (Google Account → Security → App passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# How often to check the inbox, in seconds (default 20)
# GMAIL_POLL_SECONDS=20

# Postmark is an alternative to AgentMail or Gmail.
# POSTMARK_SERVER_TOKEN=
# PLANNIE_INBOUND_ADDRESS=
# PLANNIE_FROM_ADDRESS=
# POSTMARK_WEBHOOK_USER=
# POSTMARK_WEBHOOK_PASS=

# The model that reads Plannie's email (set ONE). Without any, every email is held for a manager to review.
# Gemini on Google Cloud Vertex AI (billed to the project; needs an open billing account and
# `gcloud auth application-default login`):
GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# Gemini with a Google AI Studio key (aistudio.google.com → Get API key; has a free tier):
# GEMINI_API_KEY=
# Which Gemini model (default gemini-3.8-flash):
# PLANNIE_GEMINI_MODEL=gemini-3.8-flash
# Claude instead: ANTHROPIC_VERTEX_PROJECT_ID=  (Vertex)  or  ANTHROPIC_API_KEY=
