{
  "name": "ccplannie",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run start:demo",
    "start:demo": "PLANNIE_MODE=demo node --no-warnings server.mjs",
    "start:console": "PLANNIE_MODE=company node --no-warnings server.mjs",
    "demo": "npm run build:web && npm run start:demo",
    "console": "npm run build:web && npm run start:console",
    "build:web": "npm ci --prefix web --include=dev && npm --prefix web run build",
    "dev:web": "cd web && npx vite",
    "test": "node --no-warnings --test tests/*.test.mjs",
    "replay": "node --no-warnings scripts/replay.mjs",
    "smoke:model": "node --no-warnings scripts/model-smoke.mjs",
    "test:properties": "node --no-warnings --test tests/properties.test.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@anthropic-ai/vertex-sdk": "^1.1.3",
    "@google/genai": "^3.6.1",
    "agentmail": "^0.5.54",
    "imapflow": "^2.12.2",
    "mailparser": "^3.15.0",
    "nodemailer": "^10.6.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "fast-check": "^4.11.0",
    "playwright-core": "^1.57.0"
  }
}
